{
  "name": "leadguard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:check": "tsx --env-file=.env scripts/check-database.ts",
    "worker": "tsx --env-file=.env src/workers/run-monitor-worker.ts",
    "worker:browser": "tsx --env-file=.env src/workers/run-browser-worker.ts",
    "worker:notifications": "tsx --env-file=.env src/workers/run-notification-worker.ts",
    "worker:google-ads": "tsx --env-file=.env src/workers/run-google-ads-worker.ts",
    "scheduler": "tsx --env-file=.env src/workers/run-scheduler.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "dotenv": "^17.4.2",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.16.3",
    "pg-boss": "^12.28.1",
    "playwright-core": "^1.62.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
