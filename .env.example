# PostgreSQL connection string. Create the database with your local PostgreSQL installation.
DATABASE_URL="postgresql://leadguard:change-me@localhost:5432/leadguard?schema=public"

# Public origin of the web application.
APP_URL="http://localhost:3000"

# Auth.js canonical URL. Keep this equal to APP_URL.
AUTH_URL="http://localhost:3000"

# Auth.js session signing secret. Generate with:
# openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Set to true when the app runs behind a reverse proxy that sets X-Forwarded-* headers.
# AUTH_TRUST_HOST="true"

# logging: debug | info | warn | error
LOG_LEVEL="info"

# Optional HTTP monitoring worker/scheduler settings (defaults shown).
# MONITOR_WORKER_CONCURRENCY="5"
# MONITOR_DEFAULT_INTERVAL_SECONDS="300"
# MONITOR_MIN_INTERVAL_SECONDS="300"
# MONITOR_DEFAULT_TIMEOUT_MS="10000"
# MONITOR_MAX_TIMEOUT_MS="30000"
# MONITOR_MAX_REDIRECTS="10"
# Optional SMTP for alert email. Leave unset in local development to use the console provider.
# Copy these into .env — Next.js does not load this file.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="LeadGuard <alerts@example.com>"

# Optional notification worker concurrency (default 5).
# NOTIFICATION_WORKER_CONCURRENCY="5"

# Browser monitoring worker (Chromium). Defaults are conservative.
# BROWSER_WORKER_CONCURRENCY="2"
# BROWSER_MONITOR_DEFAULT_INTERVAL_SECONDS="600"
# BROWSER_MONITOR_MIN_INTERVAL_SECONDS="600"
# BROWSER_MONITOR_DEFAULT_TIMEOUT_MS="20000"
# BROWSER_MONITOR_MAX_TIMEOUT_MS="45000"
# BROWSER_STABILIZE_MS="800"
# BROWSER_DEGRADED_MS="10000"
# BROWSER_RECYCLE_AFTER_CHECKS="50"
# PLAYWRIGHT_CHROMIUM_SANDBOX="true"
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=""

# Form monitoring (same Chromium worker, separate queue). Defaults are conservative.
# FORM_WORKER_CONCURRENCY="1"
# FORM_MONITOR_DEFAULT_INTERVAL_SECONDS="21600"
# FORM_MONITOR_MIN_INTERVAL_SECONDS="3600"
# FORM_MONITOR_DEFAULT_TIMEOUT_MS="30000"
# FORM_MONITOR_MAX_TIMEOUT_MS="45000"
# FORM_MONITOR_SUBMISSION_TIMEOUT_MS="20000"
# FORM_MONITOR_MAX_PER_ORGANIZATION="20"
# FORM_MANUAL_COOLDOWN_MS="300000"

# Lead receipt verification (optional). Inbound email is off until domain + secret are set.
# INBOUND_EMAIL_PROVIDER="generic"
# INBOUND_EMAIL_DOMAIN="inbound.example.test"
# INBOUND_EMAIL_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
# RECEIPT_DEFAULT_TIMEOUT_MINUTES="15"
# RECEIPT_MAX_TIMEOUT_MINUTES="120"

# Google Ads destination monitoring. Development defaults to the fake provider.
# Production must use GOOGLE_ADS_PROVIDER=google plus a real OAuth client and
# developer token. Never set GOOGLE_ADS_PROVIDER=fake in production.
# GOOGLE_ADS_PROVIDER="fake"
# GOOGLE_ADS_CLIENT_ID=""
# GOOGLE_ADS_CLIENT_SECRET=""
# GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_REDIRECT_URI="http://localhost:3000/api/integrations/google-ads/callback"
# CREDENTIAL_ENCRYPTION_KEY=""
# GOOGLE_ADS_IMPACT_REFRESH_INTERVAL_SECONDS="900"
# GOOGLE_ADS_IMPACT_FINALIZE_DELAY_MINUTES="360"
# GOOGLE_ADS_IMPACT_RECONCILE_AFTER_HOURS="24"
# GOOGLE_ADS_IMPACT_MANUAL_REFRESH_COOLDOWN_SECONDS="60"
# GOOGLE_ADS_IMPACT_HOURLY_LOOKBACK_DAYS="90"

# Revenue analytics (Fase 17). Read-only Google Ads reporting + ClickView.
# GOOGLE_ADS_ANALYTICS_SYNC_INTERVAL_SECONDS="900"
# GOOGLE_ADS_ANALYTICS_RECENT_REFRESH_DAYS="7"
# GOOGLE_ADS_ANALYTICS_PERIODIC_REFRESH_DAYS="30"
# GOOGLE_ADS_ANALYTICS_DEFAULT_BACKFILL_DAYS="90"
# GOOGLE_ADS_ANALYTICS_MAX_BACKFILL_DAYS="365"
# GOOGLE_ADS_ANALYTICS_MANUAL_REFRESH_COOLDOWN_SECONDS="60"
# GOOGLE_ADS_ANALYTICS_BACKFILL_COOLDOWN_SECONDS="3600"
# GOOGLE_ADS_ANALYTICS_WORKER_CONCURRENCY="1"
# GOOGLE_ADS_CLICK_VIEW_BATCH_SIZE="50"

# Google Data Manager conversion feedback (Fase 16). Uses the same OAuth client
# as Google Ads. Base URL/version are code constants (v1). Fake provider is
# forbidden in production (same GOOGLE_ADS_PROVIDER=fake guard).
# GOOGLE_CONVERSION_WORKER_CONCURRENCY="5"
# GOOGLE_CONVERSION_STATUS_POLL_INTERVAL_SECONDS="30"
# GOOGLE_CONVERSION_STATUS_POLL_MAX_SECONDS="1800"
# GOOGLE_CONVERSION_MAX_RETRIES="8"

# Revenue attribution / Tracking SDK. Click IDs use an HKDF-derived key from
# CREDENTIAL_ENCRYPTION_KEY (not a separate named encryption secret).
# TRACKING_PUBLIC_BASE_URL="http://localhost:3000"
# TRACKING_DEFAULT_ATTRIBUTION_WINDOW_DAYS="90"
# TRACKING_DEFAULT_SESSION_TIMEOUT_MINUTES="30"
# TRACKING_EVENT_RATE_LIMIT="60"
# TRACKING_SERVER_LEAD_RATE_LIMIT="30"

# Outcome ingestion (server-to-server). Dedicated lgoi_ credentials; not tracking keys.
# OUTCOME_API_RATE_LIMIT="300"
# OUTCOME_ORG_RATE_LIMIT="600"
# OUTCOME_IP_RATE_LIMIT="120"

# Billing (Fase 18). Hosted Stripe Checkout + Customer Portal. Never put Stripe
# secrets in the browser. Production requires sk_live + live Price IDs + webhook
# secret. Fake provider is forbidden in production.
# BILLING_PROVIDER="stripe"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_WEBHOOK_SECRET_PREVIOUS=""
# STRIPE_PRICE_STARTER_MONTHLY=""
# STRIPE_PRICE_GROWTH_MONTHLY=""
# STRIPE_PRICE_PRO_MONTHLY=""
# STRIPE_PRICE_AGENCY_MONTHLY=""
# BILLING_TRIAL_DAYS="14"
# BILLING_GRACE_DAYS="3"
# BILLING_DISPLAY_PRICE_STARTER=""
# BILLING_DISPLAY_PRICE_GROWTH=""
# BILLING_DISPLAY_PRICE_PRO=""
# BILLING_DISPLAY_PRICE_AGENCY=""
# BILLING_TERMS_URL=""
# BILLING_PRIVACY_URL=""
# BILLING_CANCELLATION_URL=""

# E2E only. Never set these in production. `npm run e2e:clean` derives
# leadguard_e2e from a local DATABASE_URL named `leadguard`, or uses
# E2E_DATABASE_URL when set. Destructive reset requires ALLOW_E2E_DB_RESET.
# E2E_DATABASE_URL="postgresql://leadguard:change-me@localhost:5432/leadguard_e2e?schema=public"
# PLAYWRIGHT_PORT="3015"

# Failure screenshots. Development uses local files. Production should use S3-compatible storage.
# ARTIFACT_STORAGE_DRIVER="local"
# ARTIFACT_STORAGE_LOCAL_DIR=".leadguard-artifacts"
# ARTIFACT_RETENTION_DAYS="30"
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"
