  externalOutcomeEvents              ExternalOutcomeEvent[]
  googleAdsConversionExports         GoogleAdsConversionExport[]
  googleAdsLeadAttributionResolution GoogleAdsLeadAttributionResolution?

  @@unique([websiteId, eventId])
  @@unique([websiteId, source, externalLeadId])
  @@index([organizationId, occurredAt])
  @@index([websiteId, occurredAt])
}

model LeadAttribution {
  id                String                @id @default(cuid())
  leadId            String                @unique
  organizationId    String
  websiteId         String
  visitorId         String?
  sessionId         String?
  firstTouchId      String?
  primaryTouchId    String?
  attributionModel  LeadAttributionModel  @default(LAST_ELIGIBLE_PAID_TOUCH)
  attributionStatus LeadAttributionStatus
  finalizedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization                       Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website                            Website                             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  lead                               Lead                                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visitor                            AttributionVisitor?                 @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  session                            AttributionSession?                 @relation(fields: [sessionId], references: [id], onDelete: SetNull)
