  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  ExternalOutcomeIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  matchedLead  Lead?                      @relation(fields: [matchedLeadId], references: [id], onDelete: SetNull)

  @@unique([integrationId, sourceEventId])
  @@index([organizationId, status])
  @@index([integrationId, sourceRecordId])
  @@index([matchedLeadId])
  @@index([integrationId, sourceRecordId, effectiveAt])
}

model OutcomeImport {
  id              String                @id @default(cuid())
  organizationId  String
  integrationId   String
  createdByUserId String
  fileName        String
  fileType        OutcomeImportFileType
  storageKey      String
  mappingJson     String
  status          OutcomeImportStatus   @default(UPLOADED)
  totalRows       Int                   @default(0)
  processedRows   Int                   @default(0)
  appliedRows     Int                   @default(0)
  unmatchedRows   Int                   @default(0)
  rejectedRows    Int                   @default(0)
  staleRows       Int                   @default(0)
  conflictRows    Int                   @default(0)
  duplicateRows   Int                   @default(0)
  errorMessage    String?
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime              @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  ExternalOutcomeIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  rows         OutcomeImportRow[]

  @@index([organizationId, createdAt])
  @@index([status])
}

model OutcomeImportRow {
  id            String                     @id @default(cuid())
  importId      String
  rowNumber     Int
  sourceEventId String
  status        ExternalOutcomeEventStatus @default(RECEIVED)
  errorCode     String?
  matchedLeadId String?
  createdAt     DateTime                   @default(now())

  import OutcomeImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status])
}

/// Cached Conversion Action metadata from read-only Google Ads discovery.
model GoogleAdsConversionActionCache {
  id                             String   @id @default(cuid())
  organizationId                 String
  googleAdsCustomerId            String
  conversionActionId             String
  name                           String
  status                         String
  type                           String
  category                       String?
  countingType                   String?
  clickThroughLookbackWindowDays Int?
  syncedAt                       DateTime
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     GoogleAdsCustomer @relation(fields: [googleAdsCustomerId], references: [id], onDelete: Cascade)

  @@unique([googleAdsCustomerId, conversionActionId])
  @@index([organizationId])
}

/// Explicit Website → Google Ads customer → Conversion Action mapping for WON feedback.
model GoogleAdsConversionFeedbackConfig {
  id                           String                            @id @default(cuid())
  organizationId               String
  websiteId                    String                            @unique
  googleAdsConnectionId        String
  googleAdsCustomerId          String
  conversionActionId           String
  conversionActionNameSnapshot String
  conversionActionTypeSnapshot String?
  conversionActionCountingType String?
  clickThroughLookbackDays     Int?
  status                       GoogleAdsConversionFeedbackStatus @default(DRAFT)
  eventSource                  GoogleAdsConversionEventSource
  valuePolicy                  GoogleAdsConversionValuePolicy
  verifiedAt                   DateTime?
  enabledAt                    DateTime?
  disabledAt                   DateTime?
  lastErrorCode                String?
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  connection   GoogleAdsConnection         @relation(fields: [googleAdsConnectionId], references: [id], onDelete: Cascade)
  customer     GoogleAdsCustomer           @relation(fields: [googleAdsCustomerId], references: [id], onDelete: Cascade)
  exports      GoogleAdsConversionExport[]

  @@index([organizationId, status])
  @@index([googleAdsConnectionId])
  @@index([googleAdsCustomerId])
}

/// One Google conversion export per Lead + Conversion Action.
model GoogleAdsConversionExport {
  id                   String                              @id @default(cuid())
  organizationId       String
  websiteId            String
  leadId               String
  leadOutcomeId        String
  leadAttributionId    String
  configId             String
  googleAdsCustomerId  String
  conversionActionId   String
  transactionId        String                              @unique
  status               GoogleAdsConversionExportStatus     @default(PENDING)
  blockReason          String?
  outOfSyncReason      GoogleAdsConversionOutOfSyncReason?
  conversionTimestamp  DateTime
  valueAmountMinor     BigInt?
  currencyCode         String?
  identifierTypes      String
  eventSource          GoogleAdsConversionEventSource
  dataManagerRequestId String?                             @unique
  attemptCount         Int                                 @default(0)
  nextAttemptAt        DateTime?
  submittedAt          DateTime?
  lastStatusCheckedAt  DateTime?
  completedAt          DateTime?
  lastErrorCode        String?
  lastErrorCategory    String?
  lastWarningCodes     String?
  snapshotLockedAt     DateTime?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt

  organization Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website                            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  lead         Lead                               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  outcome      LeadOutcome                        @relation(fields: [leadOutcomeId], references: [id], onDelete: Cascade)
  attribution  LeadAttribution                    @relation(fields: [leadAttributionId], references: [id], onDelete: Cascade)
  config       GoogleAdsConversionFeedbackConfig  @relation(fields: [configId], references: [id], onDelete: Restrict)
  attempts     GoogleAdsConversionExportAttempt[]

  @@unique([leadId, conversionActionId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@index([configId, status])
  @@index([leadId])
  @@index([websiteId, status])
}

model GoogleAdsConversionExportAttempt {
  id                   String                               @id @default(cuid())
  exportId             String
  attemptNumber        Int
  kind                 GoogleAdsConversionExportAttemptKind
  dataManagerRequestId String?
  errorCode            String?
  errorCategory        String?
  createdAt            DateTime                             @default(now())

  export GoogleAdsConversionExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@index([exportId, createdAt])
}

/// Explicit Website → Google Ads customer mapping for revenue analytics (read-only).
model GoogleAdsAnalyticsConfig {
  id                    String                         @id @default(cuid())
  organizationId        String
  websiteId             String                         @unique
  googleAdsConnectionId String
  googleAdsCustomerId   String
  status                GoogleAdsAnalyticsConfigStatus @default(DRAFT)
  enabledAt             DateTime?
  disabledAt            DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastSyncAttemptAt     DateTime?
  lastManualRefreshAt   DateTime?
  lastBackfillAt        DateTime?
  nextSyncAt            DateTime?
  lastErrorCode         String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  connection   GoogleAdsConnection         @relation(fields: [googleAdsConnectionId], references: [id], onDelete: Cascade)
  customer     GoogleAdsCustomer           @relation(fields: [googleAdsCustomerId], references: [id], onDelete: Cascade)
  syncRuns     GoogleAdsAnalyticsSyncRun[]

  @@index([organizationId, status])
  @@index([googleAdsCustomerId, status])
  @@index([status, nextSyncAt])
  @@index([googleAdsConnectionId])
}

/// Daily Google Ads reported performance. ACCOUNT rows use campaignId = "".
model GoogleAdsPerformanceDaily {
  id                     String                        @id @default(cuid())
  organizationId         String
  googleAdsCustomerId    String
  date                   DateTime                      @db.Date
  dimensionType          GoogleAdsPerformanceDimension
  campaignId             String                        @default("")
  campaignNameSnapshot   String?
  campaignStatus         String?
  advertisingChannelType String?
  costMicros             BigInt
  clicks                 BigInt
  impressions            BigInt
  currencyCode           String
  customerTimeZone       String
  syncRunId              String?
  lastSyncedAt           DateTime
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     GoogleAdsCustomer @relation(fields: [googleAdsCustomerId], references: [id], onDelete: Cascade)

  @@unique([googleAdsCustomerId, date, dimensionType, campaignId])
  @@index([googleAdsCustomerId, date])
  @@index([googleAdsCustomerId, campaignId, date])
  @@index([organizationId, date])
}

model GoogleAdsAnalyticsSyncRun {
  id                  String                          @id @default(cuid())
  organizationId      String
  googleAdsCustomerId String
  configId            String?
  kind                GoogleAdsAnalyticsSyncKind
  status              GoogleAdsAnalyticsSyncRunStatus @default(RUNNING)
  rangeFrom           DateTime                        @db.Date
  rangeThrough        DateTime                        @db.Date
  accountRows         Int                             @default(0)
  campaignRows        Int                             @default(0)
  startedAt           DateTime                        @default(now())
  completedAt         DateTime?
  errorCode           String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     GoogleAdsCustomer         @relation(fields: [googleAdsCustomerId], references: [id], onDelete: Cascade)
  config       GoogleAdsAnalyticsConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([googleAdsCustomerId, startedAt])
  @@index([organizationId, startedAt])
  @@index([status, startedAt])
}

/// Primary-touch Google Ads campaign resolution. No raw click identifiers.
model GoogleAdsLeadAttributionResolution {
  id                   String                                   @id @default(cuid())
  organizationId       String
  websiteId            String
  leadId               String                                   @unique
  leadAttributionId    String                                   @unique
  attributionTouchId   String
  googleAdsCustomerId  String
  status               GoogleAdsLeadAttributionResolutionStatus @default(PENDING)
  resolutionMethod     GoogleAdsLeadAttributionResolutionMethod @default(UNRESOLVED)
  acquisitionAt        DateTime
  googleClickDate      DateTime?                                @db.Date
  campaignId           String?
  campaignNameSnapshot String?
  adGroupId            String?
  adGroupNameSnapshot  String?
  adId                 String?
  keywordCriterionId   String?
  keywordTextSnapshot  String?
  keywordMatchType     String?
  attemptCount         Int                                      @default(0)
  nextAttemptAt        DateTime?
  resolvedAt           DateTime?
  lastAttemptAt        DateTime?
  errorCode            String?
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website          Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  lead             Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attribution      LeadAttribution   @relation(fields: [leadAttributionId], references: [id], onDelete: Cascade)
  attributionTouch AttributionTouch  @relation(fields: [attributionTouchId], references: [id], onDelete: Restrict)
  customer         GoogleAdsCustomer @relation(fields: [googleAdsCustomerId], references: [id], onDelete: Cascade)

  @@index([googleAdsCustomerId, campaignId])
  @@index([status, nextAttemptAt])
  @@index([attributionTouchId])
  @@index([organizationId, status])
  @@index([websiteId])
}

enum BillingProvider {
  STRIPE
  FAKE
  INTERNAL
}

enum BillingPlanKey {
  STARTER
  GROWTH
  PRO
  AGENCY
  LEGACY
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELED
  SUSPENDED
  INCOMPLETE
  TRIAL_EXPIRED
  NEEDS_REVIEW
}

enum BillingProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum BillingCheckoutSessionStatus {
  OPEN
  COMPLETED
  EXPIRED
}

enum WorkerHeartbeatType {
  WEB
  SCHEDULER
  HTTP
  BROWSER
  NOTIFICATION
  GOOGLE_ADS
}

/// Stripe/fake customer for one Organization. No card data.
model BillingCustomer {
  id                 String          @id @default(cuid())
  organizationId     String          @unique
  provider           BillingProvider
  providerCustomerId String          @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions BillingSubscription[]
  checkouts     BillingCheckoutSession[]

  @@index([provider, providerCustomerId])
}

/// Local projection of the Organization's primary subscription.
model BillingSubscription {
  id                     String                    @id @default(cuid())
  organizationId         String                    @unique
  billingCustomerId      String?
  provider               BillingProvider
  providerSubscriptionId String                    @unique
  planKey                BillingPlanKey
  status                 BillingSubscriptionStatus
  providerStatus         String?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialStart             DateTime?
  trialEnd               DateTime?
  graceDeadlineAt        DateTime?
  cancelAtPeriodEnd      Boolean                   @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  priceId                String?
  quantity               Int                       @default(1)
  lastStripeEventAt      DateTime?
  lastReconciledAt       DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     BillingCustomer? @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)

  @@index([status, currentPeriodEnd])
  @@index([provider, status])
}

model BillingProviderEvent {
  id              String                     @id @default(cuid())
  provider        BillingProvider
  providerEventId String                     @unique
  type            String
  status          BillingProviderEventStatus @default(RECEIVED)
  eventCreatedAt  DateTime?
  receivedAt      DateTime                   @default(now())
  processedAt     DateTime?
  errorCode       String?
  organizationId  String?

  @@index([status, receivedAt])
  @@index([type, receivedAt])
}

model BillingCheckoutSession {
  id                String                       @id @default(cuid())
  organizationId    String
  billingCustomerId String?
  planKey           BillingPlanKey
  provider          BillingProvider
  providerSessionId String                       @unique
  status            BillingCheckoutSessionStatus @default(OPEN)
  idempotencyKey    String                       @unique
  expiresAt         DateTime
  completedAt       DateTime?
  createdByUserId   String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     BillingCustomer? @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model BillingAuditEvent {
  id              String   @id @default(cuid())
  organizationId  String
  actorUserId     String?
  action          String
  planKey         String?
  providerEventId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model OrganizationOnboarding {
  organizationId          String    @id
  websiteCompletedAt      DateTime?
  monitorCompletedAt      DateTime?
  notificationCompletedAt DateTime?
  firstCheckCompletedAt   DateTime?
  completedAt             DateTime?
  dismissedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WorkerHeartbeat {
  id         String              @id @default(cuid())
  workerType WorkerHeartbeatType
  instanceId String
  lastSeenAt DateTime
  version    String?
  metadata   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([workerType, instanceId])
  @@index([workerType, lastSeenAt])
}

/// Platform-level access. Independent of OrganizationMember.role.
model PlatformAccess {
  id              String               @id @default(cuid())
  userId          String               @unique
  role            PlatformRole
  status          PlatformAccessStatus @default(ACTIVE)
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, status])
}

model PlatformAuditEvent {
  id                String   @id @default(cuid())
  actorUserId       String?
  actorPlatformRole String?
  action            String
  targetType        String
  targetId          String
  organizationId    String?
  reason            String?
  metadata          String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

/// Explicit feature/limit override. Never a plan-string hack.
model OrganizationEntitlementOverride {
  id              String    @id @default(cuid())
  organizationId  String
  featureKey      String?
  limitKey        String?
  booleanValue    Boolean?
  integerValue    Int?
  reason          String
  expiresAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}
