  lastSeenAt      DateTime
  endedAt         DateTime?
  landingOrigin   String?
  landingPath     String?
  referrerDomain  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor      AttributionVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  touches      AttributionTouch[]
  tokens       AttributionToken[]
  leads        Lead[]
  attributions LeadAttribution[]

  @@unique([websiteId, publicSessionId])
  @@index([visitorId, publicSessionId])
  @@index([lastSeenAt])
  @@index([organizationId])
}

model AttributionTouch {
  id              String             @id @default(cuid())
  organizationId  String
  websiteId       String
  visitorId       String
  sessionId       String
  capturedAt      DateTime
  channel         AttributionChannel
  encryptedGclid  String?
  encryptedGbraid String?
  encryptedWbraid String?
  gclidHash       String?
  gbraidHash      String?
  wbraidHash      String?
  hasGclid        Boolean            @default(false)
  hasGbraid       Boolean            @default(false)
  hasWbraid       Boolean            @default(false)
  landingOrigin   String?
  landingPath     String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  createdAt       DateTime           @default(now())
  expiresAt       DateTime

  organization             Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website                  Website                              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor                  AttributionVisitor                   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session                  AttributionSession                   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  firstForLeads            LeadAttribution[]                    @relation("LeadFirstTouch")
  primaryForLeads          LeadAttribution[]                    @relation("LeadPrimaryTouch")
  googleAdsLeadResolutions GoogleAdsLeadAttributionResolution[]

  @@index([visitorId, capturedAt])
  @@index([websiteId, capturedAt])
  @@index([expiresAt])
  @@index([organizationId])
  @@index([gclidHash])
  @@index([gbraidHash])
  @@index([wbraidHash])
}

model AttributionToken {
  id             String    @id @default(cuid())
  organizationId String
  websiteId      String
  visitorId      String
  sessionId      String
  tokenHash      String    @unique
  issuedAt       DateTime
  expiresAt      DateTime
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor      AttributionVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session      AttributionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([websiteId])
  @@index([organizationId])
}

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  websiteId      String
  publicLeadId   String     @unique
  source         LeadSource
  occurredAt     DateTime
  receivedAt     DateTime
  eventId        String
  externalLeadId String?
  visitorId      String?
  sessionId      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization                       Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website                            Website                             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor                            AttributionVisitor?                 @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  session                            AttributionSession?                 @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  attribution                        LeadAttribution?
  outcome                            LeadOutcome?
