  website      Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sessions     AttributionSession[]
  touches      AttributionTouch[]
  tokens       AttributionToken[]
  leads        Lead[]
  attributions LeadAttribution[]

  @@unique([websiteId, publicVisitorId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([websiteId, lastSeenAt])
}

model AttributionSession {
  id              String    @id @default(cuid())
  organizationId  String
  websiteId       String
  visitorId       String
  publicSessionId String
